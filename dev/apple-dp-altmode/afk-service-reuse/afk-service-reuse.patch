Subject: [PATCH] drm/apple: reuse quiescent dpav AFK services

The dpav endpoint consumes two AFK service slots for each external display
generation. Retire and reuse only opted-in dpav services after teardown,
command completion, owner detachment, external-user release, and debugfs
quiescence.

Protect the shared dcpav service owner with a nonblocking spinlock and a
transient user count. Keep torn-down services enabled until late replies
and users release them. Reject new commands after teardown so a caller
that acquired the service before teardown cannot strand retirement.
Serialize command setup and send against teardown.

---
--- a/drivers/gpu/drm/apple/afk.c
+++ b/drivers/gpu/drm/apple/afk.c
@@ -231,19 +231,127 @@
 static struct apple_epic_service *afk_epic_find_service(struct apple_dcp_afkep *ep,
 						 u32 channel)
 {
-    for (u32 i = 0; i < ep->num_channels; i++)
-        if (ep->services[i].enabled && ep->services[i].channel == channel)
-            return &ep->services[i];
+	for (u32 i = 0; i < ep->num_channels; i++)
+		if (READ_ONCE(ep->services[i].enabled) &&
+		    ep->services[i].channel == channel)
+			return &ep->services[i];
 
     return NULL;
 }
 
+static bool afk_epic_service_can_reuse(struct apple_epic_service *service)
+{
+	return service->ops && service->ops->reusable &&
+	       service->retirement_requested && service->torndown &&
+	       !service->enabled && !service->external_users &&
+	       bitmap_empty(service->cmd_map, MAX_PENDING_CMDS) &&
+	       !service->cookie && !service->debugfs.entry &&
+	       !service->debugfs.scratch;
+}
+
+static void afk_epic_try_retire_locked(struct apple_epic_service *service)
+{
+	if (!service->ops || !service->ops->reusable ||
+	    !service->retirement_requested || !service->torndown ||
+	    service->external_users ||
+	    !bitmap_empty(service->cmd_map, MAX_PENDING_CMDS) ||
+	    service->cookie || service->debugfs.entry ||
+	    service->debugfs.scratch)
+		return;
+
+	WRITE_ONCE(service->enabled, false);
+}
+
+static int afk_epic_reserve_command_locked(struct apple_epic_service *service)
+{
+	if (!service->enabled || service->torndown)
+		return -ESHUTDOWN;
+
+	return bitmap_find_free_region(service->cmd_map, MAX_PENDING_CMDS, 0);
+}
+
+static void afk_epic_release_command_locked(struct apple_epic_service *service,
+					    u8 idx)
+{
+	bitmap_release_region(service->cmd_map, idx, 0);
+	afk_epic_try_retire_locked(service);
+}
+
+static struct apple_epic_service *
+afk_epic_prepare_service(struct apple_dcp_afkep *ep)
+{
+	struct apple_epic_service *service;
+	unsigned long flags;
+	u32 ch_idx;
+
+	for (ch_idx = 0; ch_idx < ep->num_channels; ch_idx++) {
+		service = &ep->services[ch_idx];
+		spin_lock_irqsave(&service->lock, flags);
+		if (afk_epic_service_can_reuse(service)) {
+			spin_unlock_irqrestore(&service->lock, flags);
+			goto prepare;
+		}
+		spin_unlock_irqrestore(&service->lock, flags);
+	}
+
+	if (ep->num_channels >= AFK_MAX_CHANNEL)
+		return NULL;
+
+	ch_idx = ep->num_channels++;
+
+prepare:
+	service = &ep->services[ch_idx];
+	memset(service, 0, sizeof(*service));
+	return service;
+}
+
+bool afk_service_get(struct apple_epic_service *service)
+{
+	bool acquired = false;
+	unsigned long flags;
+
+	spin_lock_irqsave(&service->lock, flags);
+	if (service->enabled && !service->torndown) {
+		service->external_users++;
+		acquired = true;
+	}
+	spin_unlock_irqrestore(&service->lock, flags);
+
+	return acquired;
+}
+
+void afk_service_put(struct apple_epic_service *service)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&service->lock, flags);
+	if (WARN_ON(!service->external_users)) {
+		spin_unlock_irqrestore(&service->lock, flags);
+		return;
+	}
+
+	service->external_users--;
+	afk_epic_try_retire_locked(service);
+	spin_unlock_irqrestore(&service->lock, flags);
+}
+
+void afk_service_request_retirement(struct apple_epic_service *service)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&service->lock, flags);
+	if (service->ops && service->ops->reusable)
+		service->retirement_requested = true;
+	afk_epic_try_retire_locked(service);
+	spin_unlock_irqrestore(&service->lock, flags);
+}
+
