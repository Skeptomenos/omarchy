 }
@@ -36,14 +46,25 @@
 static void dcpavserv_teardown(struct apple_epic_service *service)
 {
 	struct apple_dcp *dcp = service->ep->dcp;
-	service->enabled = false;
+	bool detached = false;
+	unsigned long flags;
 
-	if (dcp->dcpavserv.enabled) {
+	spin_lock_irqsave(&dcp->dcpavserv.lock, flags);
+	if (dcp->dcpavserv.service == service) {
 		dcp->dcpavserv.enabled = false;
 		dcp->dcpavserv.service = NULL;
+		detached = true;
+	}
+	spin_lock(&service->lock);
+	if (service->cookie == &dcp->dcpavserv)
 		service->cookie = NULL;
+	spin_unlock(&service->lock);
+	spin_unlock_irqrestore(&dcp->dcpavserv.lock, flags);
+
+	if (detached)
 		reinit_completion(&dcp->dcpavserv.enable_completion);
-	}
+
+	afk_service_request_retirement(service);
 }
 
 static void dcpdpserv_init(struct apple_epic_service *service, const char *name,
@@ -53,7 +74,26 @@
 
 static void dcpdpserv_teardown(struct apple_epic_service *service)
 {
-	service->enabled = false;
+	afk_service_request_retirement(service);
+}
+
+struct apple_epic_service *dcpavserv_get(struct dcpavserv *dcpavserv)
+{
+	struct apple_epic_service *service = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&dcpavserv->lock, flags);
+	if (dcpavserv->enabled && dcpavserv->service &&
+	    afk_service_get(dcpavserv->service))
+		service = dcpavserv->service;
+	spin_unlock_irqrestore(&dcpavserv->lock, flags);
+
+	return service;
+}
+
+void dcpavserv_put(struct apple_epic_service *service)
+{
+	afk_service_put(service);
 }
 
