#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

# Mac fork: upstream migrations sometimes install packages that don't exist in
# Arch Linux ARM's repos (e.g. x86-only packages). Filter to what is actually
# installable here so those installs skip cleanly with a warning instead of
# hard-failing the whole migration.
resolve_package_for_arch() {
  local package="$1"

  if [[ $(uname -m) == "aarch64" && $package == "tensaku" ]]; then
    printf '%s\n' "${OMARCHY_TENSAKU_PACKAGE:-tensaku-bin}"
  else
    printf '%s\n' "$package"
  fi
}

to_install=()
for pkg in "$@"; do
  install_pkg=$(resolve_package_for_arch "$pkg")

  if pacman -Q "$pkg" &>/dev/null; then
    continue
  elif pacman -Si "$install_pkg" &>/dev/null; then
    to_install+=("$install_pkg")
  elif [[ $install_pkg == "tensaku-bin" && $EUID != 0 && $(command -v yay 2>/dev/null) ]]; then
    # tensaku-bin is an AUR package, not an Arch Linux ARM repository package.
    # The fresh Mac installer installs yay before migrations run.
    to_install+=("$install_pkg")
  else
    echo -e "\033[33mSkipping '$pkg': no ARM-compatible package source is available\033[0m" >&2
  fi
done

((${#to_install[@]})) || exit 0

if (( EUID == 0 )); then
  pacman -S --noconfirm --needed "${to_install[@]}" || exit 1
else
  if [[ " ${to_install[*]} " == *" tensaku-bin "* ]]; then
    yay -S --noconfirm --needed "${to_install[@]}" || exit 1
  else
    sudo pacman -S --noconfirm --needed "${to_install[@]}" || exit 1
  fi
fi

for install_pkg in "${to_install[@]}"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q "$install_pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$install_pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
