#!/bin/bash

# omarchy:summary=Install the Claude desktop app
# omarchy:requires-sudo=true

set -euo pipefail

echo "Installing Claude..."
omarchy-pkg-add claude-desktop
if ! omarchy-pkg-present claude-desktop; then
  echo "Claude Desktop is unavailable from the configured package sources." >&2
  exit 1
fi

echo "Opening Claude..."
setsid uwsm-app -- /usr/bin/claude-desktop >/dev/null 2>&1 &

echo ""
echo "Claude has been installed."
