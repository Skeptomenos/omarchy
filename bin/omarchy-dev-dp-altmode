#!/bin/bash
set -Eeuo pipefail

[[ \$EUID -eq 0 ]] || { printf 'Run with sudo bash, not as an executable.\n' >&2; exit 1; }
EXPECTED_KERNEL='$DPALT_KERNEL_RELEASE'
