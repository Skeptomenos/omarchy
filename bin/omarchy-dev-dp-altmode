if [[ ,\$mount_options, == *,rw,* ]]; then
  mount -o remount,ro "\$ESP"
  mount_options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
fi
[[ ,\$mount_options, == *,ro,* ]]
printf '%s  %s\n' "\$EXPECTED_STOCK" "\$ACTIVE" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_NOTE" "\$ROLLBACK_NOTE" | sha256sum --check --strict
[[ ! -e \$EFI_BACKUP && ! -e \$PERSISTENT_BACKUP && ! -e \$EFI_NOTE && ! -e \$BASELINE ]]

esp_rw=0
remount_esp_ro() {
  local status=\$?
  local options=''
  if (( esp_rw )); then
    if mount -o remount,ro "\$ESP"; then
      options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
      if [[ ,\$options, == *,ro,* ]]; then
        esp_rw=0
      else
        status=1
      fi
    else
      status=1
    fi
  fi
  return "\$status"
}
trap remount_esp_ro EXIT
trap 'exit 130' INT TERM HUP

esp_rw=1
mount -o remount,rw "\$ESP"
mount_options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
[[ ,\$mount_options, == *,rw,* ]]
cp --preserve=timestamps --no-clobber "\$ACTIVE" "\$EFI_BACKUP"
cp --preserve=timestamps --no-clobber "\$ACTIVE" "\$PERSISTENT_BACKUP"
cp --no-clobber "\$ROLLBACK_NOTE" "\$EFI_NOTE"
chmod 0644 "\$EFI_NOTE"
printf '%s  %s\n' "\$EXPECTED_STOCK" "\$EFI_BACKUP" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_STOCK" "\$PERSISTENT_BACKUP" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_NOTE" "\$EFI_NOTE" | sha256sum --check --strict
sha256sum "\$ACTIVE" /boot/initramfs-linux-asahi.img /boot/grub/grub.cfg >"\$BASELINE"
sync -f "\$EFI_BACKUP"
sync -f "\$EFI_NOTE"
sync -f "\$ESP"
mount -o remount,ro "\$ESP"
mount_options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
if [[ ,\$mount_options, == *,rw,* ]]; then
  mount -o remount,ro "\$ESP"
  mount_options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
fi
[[ ,\$mount_options, == *,ro,* ]]
esp_rw=0
trap - EXIT INT TERM HUP
printf 'Gate 0 PASS. Keep both timestamped backups.\n'
EOF

