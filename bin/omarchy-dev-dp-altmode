  [[ -L /sys/bus/i2c/drivers/tps6598x/\$controller ]]
done
[[ -d /sys/module/tps6598x_core && -d /sys/module/tps6598x ]]

restore_stock() {
  local status="\${1:-\$?}"
  trap - EXIT ERR INT TERM HUP
  set +e
  modprobe -r tps6598x tps6598x_core
  modprobe tps6598x || status=1
  for controller in 0-003a 0-0038 0-003f; do
    [[ -L /sys/bus/i2c/drivers/tps6598x/\$controller ]] || status=1
  done
  [[ -d /sys/module/tps6598x_core && -d /sys/module/tps6598x ]] || status=1
  exit "\$status"
}
trap restore_stock EXIT ERR
trap 'restore_stock 130' INT TERM HUP

modprobe -r tps6598x tps6598x_core
insmod "\$CANDIDATE"
modprobe tps6598x
for controller in 0-003a 0-0038 0-003f; do
  [[ -L /sys/bus/i2c/drivers/tps6598x/\$controller ]]
done
trap - EXIT ERR INT TERM HUP

printf 'Patched core loaded. Now connect the monitor to the front/lower left USB-C port.\n'
read -r -p 'Press Enter after the monitor is connected: '
partner_path=''
for (( attempt = 0; attempt < 20; attempt++ )); do
  for partner in /sys/class/typec/port*-partner; do
    [[ -e \$partner ]] || continue
    resolved=\$(readlink -f "\$partner")
    if [[ \$resolved == *'/0-003f/'* ]]; then
      partner_path="\$resolved"
      break 2
    fi
  done
  sleep 0.5
done
[[ \$partner_path == *'/0-003f/'* ]] || {
  printf 'No partner appeared on 0-003f. Unplug the cable and reboot to restore the stock module.\n' >&2
  exit 1
}
printf 'Gate 3 PASS: partner is %s\n' "\$partner_path"
EOF

  cat >"$stage/commands/04-one-boot-initramfs.txt" <<'EOF'
Gate 4 — DEFERRED. This prototype does not build or install an alternate initramfs yet.
Do not run grub-mkconfig. Do not edit /boot/grub/grub.cfg or /etc/default/grub.
The next implementation must use a new '/boot/initramfs-linux-asahi-dpalt.img' and a one-time GRUB edit only.
EOF

  cat >"$stage/commands/06-cleanup.txt" <<EOF
Restore the stock boot chain with the fixed transactional script:
sudo bash '$stage/commands/02-rollback-dtb.sh'
sudo reboot

After the stock boot, verify package files and keep the EFI backup until DEV-147 closes:
pacman -Qkk linux-asahi
test ! -e '/etc/default/update-m1n1'
EOF

  cat >"$stage/commands/README.txt" <<EOF
DEV-147 contained J413 DisplayPort gates

Inspect each non-executable script before use. Run one gate at a time.
Before activation, confirm normal macOS or Recovery access and keep the battery above 50%.
Keep the offline instructions in '$mac_guide' available before reboot.
Gate 2 copies and verifies that guide and its macOS restore script onto EFI before replacing boot.bin.

Gate 0: sudo bash '$stage/commands/00-baseline-and-backup.sh'
Gate 2: sudo bash '$stage/commands/02-activate-dtb.sh'
Then: sudo reboot
Gate 3 after the DTB-only boot passes: sudo bash '$stage/commands/03-live-module.sh'

Immediate live-module rollback: unplug the monitor, then run sudo reboot
DTB rollback: sudo bash '$stage/commands/02-rollback-dtb.sh'
Then: sudo reboot

Gate 4 is deferred. Do not run update-m1n1 or grub-mkconfig.
EOF

  chmod 0600 "$stage/commands"/*.txt
  chmod 0600 "$stage/commands"/*.sh
}

build_prototype() {
  local source="$1"
  local header_root="$2"
  local requested_output="$3"
  local output=""
  local patched=""
  local patch_dir=""
  local dtc=""
  local stock_dtb=""
  local patched_dtb=""
  local timestamp=""

  [[ ${OMARCHY_DPALT_TEST_ROOT:-/} == "/" ]] ||
    dpalt_error "build cannot run with a test system root"
  [[ ${OMARCHY_DPALT_TEST_ALLOW_TMPFS:-0} != 1 ]] ||
    dpalt_error "build cannot bypass the persistent-output gate"
  (( EUID != 0 )) || dpalt_error "build must run without root or sudo"
  verify_host_baseline >/dev/null

  source=$(realpath -e -- "$source")
  header_root=$(realpath -e -- "$header_root")
  [[ -d $source && -d $header_root ]] || dpalt_error "source and header root must be directories"
  output=$(validate_output_path "$requested_output")
  [[ $output != "$source" && $output != "$source"/* && $output != "$header_root" && $output != "$header_root"/* ]] ||
    dpalt_error "--output must be separate from source and header inputs"

  : "${OMARCHY_PATH:?OMARCHY_PATH must point to this checkout}"
  patch_dir="$OMARCHY_PATH/dev/apple-dp-altmode"
  [[ -f $patch_dir/t8112-j413-dp-altmode.patch && -f $patch_dir/tipd-cd321x-hpd.patch ]] ||
    dpalt_error "prototype patches are missing under OMARCHY_PATH"

  umask 077
  mkdir -p "$output/artifacts" "$output/evidence" "$output/work"
  printf 'Build incomplete. Do not activate artifacts.\n' >"$output/BUILD-INCOMPLETE"
  patched="$output/work/patched-source"

  verify_source_tree "$source"
  copy_and_patch_sources "$source" "$patched" "$patch_dir"

  dtc="$header_root/usr/lib/modules/$DPALT_KERNEL_RELEASE/build/scripts/dtc/dtc"
  [[ -x $dtc ]] || dpalt_error "matching private DTC is missing: $dtc"
  stock_dtb="$output/evidence/t8112-j413.stock-built.dtb"
  patched_dtb="$output/artifacts/t8112-j413.dpalt.dtb"
  compile_dtb "$source" "$source/$DPALT_DTB_REL" "$stock_dtb" "$dtc" "$(dirname "$source/$DPALT_DTB_REL")"
  cmp -s "$stock_dtb" "/usr/lib/modules/$DPALT_KERNEL_RELEASE/dtbs/t8112-j413.dtb" ||
    dpalt_error "unmodified source does not reproduce the packaged J413 DTB"
  compile_dtb "$source" "$patched/$DPALT_DTB_REL" "$patched_dtb" "$dtc" "$(dirname "$patched/$DPALT_DTB_REL")"
  verify_patched_dtb "$patched_dtb" "$dtc" "$output/evidence"

  build_module "$patched" "$header_root" "$patch_dir" "$output"
  build_boot_candidates "$output" "$patched_dtb"
  verify_source_tree "$source"

  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  write_command_plan "$output" "$timestamp"
  sha256sum "$output/artifacts"/* >"$output/evidence/artifacts.sha256"
  rm -f "$output/BUILD-INCOMPLETE"
  printf 'Prototype build: PASS\nStage: %s\nNext: read %s/commands/README.txt\n' "$output" "$output"
}

main() {
  local action="${1:-}"
  local source=""
  local header_root=""
  local output=""

  case "$action" in
    -h | --help | "")
      usage
      ;;
    check)
      shift
      (( $# == 0 )) || dpalt_error "check takes no arguments"
      (( EUID != 0 )) || dpalt_error "check must run without root or sudo"
      verify_host_baseline
      ;;
    build)
      shift
      while (( $# )); do
        case "$1" in
          --source)
            [[ $# -ge 2 ]] || dpalt_error "--source needs a directory"
            source="$2"
            shift 2
            ;;
          --header-root)
            [[ $# -ge 2 ]] || dpalt_error "--header-root needs a directory"
            header_root="$2"
            shift 2
            ;;
          --output)
            [[ $# -ge 2 ]] || dpalt_error "--output needs a directory"
            output="$2"
            shift 2
            ;;
          *)
            dpalt_error "unknown build option: $1"
            ;;
        esac
      done
      [[ -n $source && -n $header_root && -n $output ]] ||
        dpalt_error "build requires --source, --header-root, and --output"
      build_prototype "$source" "$header_root" "$output"
      ;;
    *)
      dpalt_error "unknown action: $action"
      ;;
  esac
}

if [[ ${OMARCHY_DPALT_LIBRARY:-0} != 1 ]]; then
  main "$@"
fi
