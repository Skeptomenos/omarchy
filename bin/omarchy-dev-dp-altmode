[[ \$(uname -r) == "\$EXPECTED_KERNEL" ]]
[[ ! -e /etc/default/update-m1n1 ]]
battery=\$(</sys/class/power_supply/macsmc-battery/capacity)
(( battery > 50 ))
[[ \$(findmnt -n -o SOURCE -T "\$ESP" | sed -n '1p') == "\$ESP_DEVICE" ]]
[[ \$(findmnt -n -o FSTYPE -T "\$ESP" | sed -n '1p') == 'vfat' ]]
