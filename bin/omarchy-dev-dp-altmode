mount_options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
if [[ ,\$mount_options, == *,rw,* ]]; then
  mount -o remount,ro "\$ESP"
  mount_options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
fi
[[ ,\$mount_options, == *,ro,* ]]
printf '%s  %s\n' "\$EXPECTED_STOCK" "\$ACTIVE" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_STOCK" "\$EFI_BACKUP" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_STOCK" "\$PERSISTENT_BACKUP" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_CANDIDATE" "\$CANDIDATE" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_MAC_SCRIPT" "\$MAC_SCRIPT" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_MAC_GUIDE" "\$MAC_GUIDE" | sha256sum --check --strict
[[ ! -e \$TMP && ! -e \$ROLLBACK_TMP ]]
partner_3f=''
for partner in /sys/class/typec/port*-partner; do
  [[ -e \$partner ]] || continue
  resolved=\$(readlink -f "\$partner")
  [[ \$resolved != *'/0-0038/'* ]]
  if [[ \$resolved == *'/0-003f/'* ]]; then
    partner_3f="\$resolved"
  fi
done
[[ \$partner_3f == *'/0-003f/'* ]]

esp_rw=0
remount_esp_ro() {
  local status=\$?
  local options=''
  if (( esp_rw )); then
    if mount -o remount,ro "\$ESP"; then
      options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
      if [[ ,\$options, == *,ro,* ]]; then
        esp_rw=0
      else
        status=1
      fi
    else
      status=1
    fi
  fi
  return "\$status"
}
activation_failed() {
  local status="\${1:-\$?}"
  local current_sha=""
  local recovery_rw=0
  trap - ERR INT TERM HUP
  set +e
  current_sha=\$(sha256sum "\$ACTIVE" 2>/dev/null | awk '{print \$1}')
  if [[ \$current_sha != "\$EXPECTED_STOCK" ]]; then
    esp_rw=1
    if mount -o remount,rw "\$ESP"; then
      recovery_rw=1
    else
      status=1
    fi
    if (( recovery_rw )) && printf '%s  %s\n' "\$EXPECTED_STOCK" "\$EFI_BACKUP" | sha256sum --check --strict; then
      install -m 0755 -T "\$EFI_BACKUP" "\$ROLLBACK_TMP" &&
        printf '%s  %s\n' "\$EXPECTED_STOCK" "\$ROLLBACK_TMP" | sha256sum --check --strict &&
        sync -f "\$ROLLBACK_TMP" &&
        mv --no-copy -T "\$ROLLBACK_TMP" "\$ACTIVE" &&
        printf '%s  %s\n' "\$EXPECTED_STOCK" "\$ACTIVE" | sha256sum --check --strict &&
        sync -f "\$ACTIVE" || status=1
    else
      status=1
    fi
  fi
  rm -f "\$TMP" "\$ROLLBACK_TMP"
  exit "\$status"
}
trap remount_esp_ro EXIT
trap activation_failed ERR
trap 'activation_failed 130' INT TERM HUP

esp_rw=1
mount -o remount,rw "\$ESP"
mount_options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
[[ ,\$mount_options, == *,rw,* ]]
install -m 0644 -T "\$MAC_SCRIPT" "\$EFI_MAC_SCRIPT"
install -m 0644 -T "\$MAC_GUIDE" "\$EFI_MAC_GUIDE"
printf '%s  %s\n' "\$EXPECTED_MAC_SCRIPT" "\$EFI_MAC_SCRIPT" | sha256sum --check --strict
printf '%s  %s\n' "\$EXPECTED_MAC_GUIDE" "\$EFI_MAC_GUIDE" | sha256sum --check --strict
sync -f "\$EFI_MAC_SCRIPT"
sync -f "\$EFI_MAC_GUIDE"
sync -f "\$ESP"
install -m 0755 -T "\$CANDIDATE" "\$TMP"
printf '%s  %s\n' "\$EXPECTED_CANDIDATE" "\$TMP" | sha256sum --check --strict
sync -f "\$TMP"
mv --no-copy -T "\$TMP" "\$ACTIVE"
printf '%s  %s\n' "\$EXPECTED_CANDIDATE" "\$ACTIVE" | sha256sum --check --strict
sync -f "\$ACTIVE"
sync -f "\$ESP"
mount -o remount,ro "\$ESP"
mount_options=\$(findmnt -n -o OPTIONS -T "\$ESP" | sed -n '1p')
[[ ,\$mount_options, == *,ro,* ]]
esp_rw=0
trap - EXIT ERR INT TERM HUP
printf 'Gate 2 activation PASS. Reboot, then verify the internal panel before Gate 3.\n'
EOF

